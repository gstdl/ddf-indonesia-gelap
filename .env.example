# Copy to .env and fill in your own values. .env is git-ignored.

# Google Cloud project that owns the Fact Check Tools API key and its quota (Application Default Credentials).
PROJECT_ID=

# Display name of the API key minted through Application Default Credentials.
KEY_DISPLAY_NAME=

# Secret salt for hashing account identifiers before publishing. Generate with: openssl rand -hex 32
ANONYMIZATION_SALT=
